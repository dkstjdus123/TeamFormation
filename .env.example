# 이 파일을 복사해 이름을 정확히 .env 로 바꾼 뒤 값을 자기 것으로 채웁니다(.env는 깃허브에 올라가지 않음).
# 배포한 앱에는 같은 이름으로 Streamlit Secrets에 넣습니다.
OPENROUTER_API_KEY="sk-or-v1-자기 키"
DATABASE_URL="Supabase에서 복사한 DB 주소(Session pooler)"
ADMIN_PASSWORD="정한 관리자 비밀번호"

# 고른 모델 3개. 적지 않으면 인공지능.py의 기본 모델을 씁니다.
AI_MODEL_1="nvidia/nemotron-3-super-120b-a12b:free"
AI_MODEL_2="openai/gpt-oss-120b:free"
AI_MODEL_3="z-ai/glm-4.5-air:free"
